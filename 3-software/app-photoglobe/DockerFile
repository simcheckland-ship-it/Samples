# Step 1: Choose your base image (assuming a Node build environment for React)
FROM node:20-alpine AS build
WORKDIR /app

# Step 2: Define BUILD-TIME arguments (matches your GitHub Action --build-arg flags)
ARG VITE_BASE_URL_LOCAL
ARG VITE_BASE_URL_PUBLIC
ARG VITE_CESIUM_KEY
ARG VITE_GOOGLE_KEY
ARG VITE_OS_KEY
ARG VITE_TT_KEY
ARG VITE_APP_ENV=production

# Step 3: Convert ARGs into actual Environment Variables so Vite can read them during 'npm run build'
ENV VITE_BASE_URL_LOCAL=$VITE_BASE_URL_LOCAL
ENV VITE_BASE_URL_PUBLIC=$VITE_BASE_URL_PUBLIC
ENV VITE_CESIUM_KEY=$VITE_CESIUM_KEY
ENV VITE_GOOGLE_KEY=$VITE_GOOGLE_KEY
ENV VITE_OS_KEY=$VITE_OS_KEY
ENV VITE_TT_KEY=$VITE_TT_KEY
ENV VITE_APP_ENV=$VITE_APP_ENV

# Step 4: Copy package files and install dependencies
COPY package*.json ./
RUN npm ci

# Step 5: Copy your source code and build the React app
COPY . .
RUN npm run build

# Step 6: Production environment
FROM nginx:alpine

# 1. Copy your custom server configuration file over the default one
COPY nginx.conf /etc/nginx/conf.d/default.conf

# 2. Copy the compiled static production assets from the builder stage
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
